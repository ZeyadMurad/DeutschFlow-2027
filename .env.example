# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side passcode for the designated DeutschFlow owner administrator.
# Leave unset to use the one-time secure owner claim flow on first run.
ADMIN_PASSCODE=

# RESEND_API_KEY: Optional server-side API key if sending suggestion emails automatically via Resend.
RESEND_API_KEY=

# AUTH_SESSION_SECRET: Optional secret for signing biometric (WebAuthn) user sessions.
# When unset, an ephemeral random key is generated per server start (users then
# need to re-verify their fingerprint after each server restart).
AUTH_SESSION_SECRET=

# WEBAUTHN_RP_ID: Optional WebAuthn Relying Party ID (your domain, e.g. deutschflow.onrender.com).
# When unset, it is derived automatically from the request Host header.
WEBAUTHN_RP_ID=

# WEBAUTHN_RP_ORIGIN: Optional origin URL (e.g. https://deutschflow.onrender.com).
# When unset, derived automatically from request headers (honours x-forwarded-proto).
WEBAUTHN_RP_ORIGIN=
